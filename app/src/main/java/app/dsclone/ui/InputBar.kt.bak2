@Composable
fun ToggleChip(text: String, on: Boolean, onClick: () -> Unit) {
    Chip(icon = 0, text = text, on = on, onClick = onClick, tapWidth = 114.29.dp)
}

/**
 * 官方 chip：药丸高 30.10dp、圆角 15.05dp，点击区 47.62dp 高。
 * 选中态：底 #EDF3FE、图标 #426EFE、文字 #191B23；未选中：白底 + 1dp #EDEDED 描边。
 */
@Composable
private fun Chip(
    icon: Int,
    text: String,
    on: Boolean,
    onClick: () -> Unit,
    tapWidth: androidx.compose.ui.unit.Dp,
    lottieRes: Int = 0,
    lottieOnRes: Int = 0,
    enabled: Boolean = true,
) {
    val ds = LocalDsColors.current
    val shape = RoundedCornerShape(15.05.dp)
    // 官方实测（2.9.0，芯片态截图取色）：
    //   未选中：白底 + 1dp #EDEDED 边框 + 图标 #8E9094 + 文字 #191B23 + 图标 17.52dp
    //   选中：填充 #EDF3FE + 1dp #D3E2FF 边框 + 图标 #426EFE + **文字也变 #426EFE** + 图标 19.05dp
    val fill by androidx.compose.animation.animateColorAsState(
        targetValue = if (on) ds.bubble else Color.White,
        animationSpec = androidx.compose.animation.core.tween(180),
        label = "chipFill",
    )
    val borderCol by androidx.compose.animation.animateColorAsState(
        targetValue = if (on) Color(0xFFD3E2FF) else ds.chipBorder,
        animationSpec = androidx.compose.animation.core.tween(180),
        label = "chipBorder",
    )
    val iconCol by androidx.compose.animation.animateColorAsState(
        targetValue = if (!enabled) Color(0xFFB9BABB) else if (on) ds.chipIcon else Color(0xFF0F0F0F),
        animationSpec = androidx.compose.animation.core.tween(180),
        label = "chipIconColor",
    )
    val textCol by androidx.compose.animation.animateColorAsState(
        targetValue = if (!enabled) Color(0xFFB9BABB) else if (on) ds.chipIcon else ds.chipText,
        animationSpec = androidx.compose.animation.core.tween(180),
        label = "chipTextColor",
    )
    val iconSize = 17.52f
    Box(
        Modifier
            .width(tapWidth)
            .height(DsMetric.CHIP_TAP.dp)
            .clickable(enabled = enabled, onClick = onClick),
        contentAlignment = Alignment.BottomCenter,
    ) {
        Row(
            Modifier
                .width(94.86.dp)
                .height(DsMetric.CHIP_H.dp)
                .clip(shape)
                .border(1.dp, borderCol, shape)
                .background(fill)
                .padding(start = 7.61.dp),
            verticalAlignment = Alignment.CenterVertically,
        ) {
            if (lottieRes != 0) {
                // 两个状态各预载一份 composition，切换时不再出现"图标消失一下"的空档
                val compOff by com.airbnb.lottie.compose.rememberLottieComposition(
                    com.airbnb.lottie.compose.LottieCompositionSpec.RawRes(lottieRes)
                )
                val compOn by com.airbnb.lottie.compose.rememberLottieComposition(
                    com.airbnb.lottie.compose.LottieCompositionSpec.RawRes(
                        if (lottieOnRes != 0) lottieOnRes else lottieRes
                    )
                )
                val play = remember { androidx.compose.animation.core.Animatable(1f) }
                val dur = if (lottieRes == R.raw.think) 433 else 500
                androidx.compose.runtime.LaunchedEffect(on) {
                    play.snapTo(0f)
                    play.animateTo(1f, androidx.compose.animation.core.tween(dur))
                }
                // 与文字同一条 180ms 曲线做颜色交叉淡入，避免"图标先蓝、文字后蓝"
                val tintMix by androidx.compose.animation.core.animateFloatAsState(
                    targetValue = if (on) 1f else 0f,
                    animationSpec = androidx.compose.animation.core.tween(180),
                    label = "chipIconTintMix",
                )
                Box(Modifier.size(iconSize.dp)) {
                    if (compOff != null) {
                        com.airbnb.lottie.compose.LottieAnimation(
                            composition = compOff,
                            progress = { play.value },
                            modifier = Modifier
                                .fillMaxSize()
                                .alpha(1f - tintMix),
                        )
                    }
                    if (compOn != null) {
                        com.airbnb.lottie.compose.LottieAnimation(
                            composition = compOn,
                            progress = { play.value },
                            modifier = Modifier
                                .fillMaxSize()
                                .alpha(tintMix),
                        )
                    }
                }
                Spacer(Modifier.width(3.81.dp))
            } else if (icon != 0) {
                Icon(
                    painter = painterResource(icon),
                    contentDescription = null,
                    tint = iconCol,
                    modifier = Modifier.size(iconSize.dp),
                )
                Spacer(Modifier.width(3.81.dp))
            }
            Text(
                text = text,
                fontSize = 14.sp,
                lineHeight = 19.43.sp,
                maxLines = 1,
                softWrap = false,
                color = textCol,
            )
        }
    }
}

@Composable
fun InputBar(
    value: String,
    onValueChange: (String) -> Unit,
    attachments: List<Attachment>,
    onAddAttachment: () -> Unit,
    onRemoveAttachment: (Attachment) -> Unit,
    sending: Boolean,
    thinking: Boolean,
    search: Boolean,
    editing: Boolean,
    onToggleThinking: () -> Unit,
    onToggleSearch: () -> Unit,
    onCancelEdit: () -> Unit,
    onSend: () -> Unit,
    onStop: () -> Unit,
    attachOpen: Boolean = false,
    showFooter: Boolean = true,
    voiceMode: Boolean = false,
    voiceListening: Boolean = false,
    /** 正在按住说话（卡片内容换成语音遮罩，高度不变） */
    voiceHolding: Boolean = false,
    /** 当前电平 0..1 */
    voiceLevel: Float = 0f,
    /** 55 段幅度（官方 waveformMagnitudesProducer 是 55 条） */
    voiceBands: FloatArray = FloatArray(55),
    onToggleVoice: () -> Unit = {},
    onVoiceStart: () -> Unit = {},
    onVoiceStop: () -> Unit = {},
    onVoiceCancel: () -> Unit = {},
    onVoiceCancelArm: (Boolean) -> Unit = {},
    // 上下文用量圈（「+」左边 22dp 细环）：已用 tokens / 上限 tokens，调用方在 DsApp 里算好传进来
    contextUsed: Int = 0,
    contextLimit: Int = 131072,
) {
    val ds = LocalDsColors.current
    Column(
        Modifier
            .fillMaxWidth()
            .imePadding()
            .padding(horizontal = DsMetric.CARD_MARGIN_X.dp)
    ) {
        if (editing) {
            Row(
                Modifier
                    .fillMaxWidth()
                    .padding(start = 4.dp, bottom = 4.dp),
                verticalAlignment = Alignment.CenterVertically,
            ) {
                Text(
                    text = "正在编辑已发送的消息",
                    fontSize = 12.sp,
                    color = ds.subText,
                    modifier = Modifier.weight(1f),
                )
                Text(
                    text = "取消",
                    fontSize = 12.sp,
                    color = DsBlue,
                    modifier = Modifier
                        .clickable(onClick = onCancelEdit)
                        .padding(6.dp),
                )
            }
        }
        Surface(
            shape = RoundedCornerShape(DsMetric.CARD_RADIUS.dp),
            color = MaterialTheme.colorScheme.surface,
            border = androidx.compose.foundation.BorderStroke(1.dp, ds.chipBorder),
            shadowElevation = 2.dp,
        ) {
            val keyboardCtx = androidx.compose.ui.platform.LocalContext.current
            val view = androidx.compose.ui.platform.LocalView.current
            val keyboardCtrl = androidx.compose.ui.platform.LocalSoftwareKeyboardController.current
            val fieldScope = androidx.compose.runtime.rememberCoroutineScope()
            var fieldJob by androidx.compose.runtime.remember { androidx.compose.runtime.mutableStateOf<kotlinx.coroutines.Job?>(null) }
            var fieldHolding by androidx.compose.runtime.remember { androidx.compose.runtime.mutableStateOf(false) }
            val fieldCancelPx = with(androidx.compose.ui.platform.LocalDensity.current) { 60.dp.toPx() }
            val fieldDownY = androidx.compose.runtime.remember { floatArrayOf(0f) }
            Column(Modifier.padding(top = 15.23.dp, bottom = 10.28.dp)) {
                AttachmentStrip(attachments = attachments, onRemove = onRemoveAttachment)
                if (!voiceMode) {
                    val fieldFocus = androidx.compose.runtime.remember { androidx.compose.ui.focus.FocusRequester() }
                    Box {
                    if (voiceHolding) {
                        // 官方 VoiceMaskInputContent：录音时卡片内容换成遮罩 + 波形（同一张卡片，高度不变）
                        VoiceWaveInCard(level = voiceLevel, bands = voiceBands, canceling = voiceListening)
                    } else {
                    BasicTextField(
                        value = value,
                        onValueChange = onValueChange,
                        modifier = Modifier
                            .fillMaxWidth()
                            .focusRequester(fieldFocus)
.heightIn(min = 24.76.dp)
                            .padding(horizontal = DsMetric.CARD_PAD_H.dp),
                        textStyle = MaterialTheme.typography.bodyLarge.copy(
                            fontSize = DsMetric.BODY_SIZE.sp,
                            lineHeight = DsMetric.LABEL_LINE.sp,
                            color = ds.bodyText,
                        ),
                        cursorBrush = SolidColor(DsBlue),
                        maxLines = 6,
                        keyboardOptions = KeyboardOptions(imeAction = ImeAction.Send),
                        keyboardActions = KeyboardActions(onSend = { onSend() }),
                        decorationBox = { inner ->
                            if (value.isEmpty()) {
                                Text(
                                    text = "发消息或按住说话",
                                    color = ds.placeholder,
                                    fontSize = DsMetric.BODY_SIZE.sp,
                                    lineHeight = DsMetric.LABEL_LINE.sp,
                                )
                            }
                            inner()
                        },
                    )
                    }
                    if (value.isEmpty() || voiceHolding) {
                        // 盖一层透明热区：吃掉所有触摸，输入框就不会拿焦点、不会弹键盘。
                        // 短按 → 手动 requestFocus 弹键盘；按住 ≥300ms → 直接录音。
                        val hScope = androidx.compose.runtime.rememberCoroutineScope()
                        var hJob by androidx.compose.runtime.remember { androidx.compose.runtime.mutableStateOf<kotlinx.coroutines.Job?>(null) }
                        var hHolding by androidx.compose.runtime.remember { androidx.compose.runtime.mutableStateOf(false) }
                        val hCancelPx = with(androidx.compose.ui.platform.LocalDensity.current) { 60.dp.toPx() }
                        val hDownY = androidx.compose.runtime.remember { floatArrayOf(0f) }
                        Box(
                            Modifier
                                .matchParentSize()
                                .pointerInteropFilter { ev ->
                                    when (ev.action) {
                                        android.view.MotionEvent.ACTION_DOWN -> {
                                            hDownY[0] = ev.rawY
                                            hJob = hScope.launch {
                                                kotlinx.coroutines.delay(300)
                                                hHolding = true
                                                runCatching { onVoiceStart() }
                                                onVoiceCancelArm(false)
                                            }
                                            true
                                        }
                                        android.view.MotionEvent.ACTION_MOVE -> {
                                            if (hHolding) onVoiceCancelArm((hDownY[0] - ev.rawY) > hCancelPx)
                                            true
                                        }
                                        android.view.MotionEvent.ACTION_UP, android.view.MotionEvent.ACTION_CANCEL -> {
                                            hJob?.cancel()
                                            if (hHolding) {
                                                hHolding = false
                                                val up = hDownY[0] - ev.rawY
                                                if (up > hCancelPx || ev.action == android.view.MotionEvent.ACTION_CANCEL) onVoiceCancel() else onVoiceStop()
                                            } else {
                                                runCatching { fieldFocus.requestFocus() }
                                            }
                                            true
                                        }
                                        else -> true
                                    }
                                },
                        )
                    }
                    }
                } else {
            val voiceDownY = remember { floatArrayOf(0f) }
            val voiceArmed = remember { booleanArrayOf(false) }
            val voiceCancelPx = with(androidx.compose.ui.platform.LocalDensity.current) { 60.dp.toPx() }
                    // 按住说话：按下开始识别，松手结束
                    Box(
                        Modifier
                            .fillMaxWidth()
                            .padding(horizontal = DsMetric.CARD_PAD_H.dp)
                            // 官方实测：按住说话是白底上的纯文字（#2A2C33），没有灰色药丸底；
                            // 而且切语音模式时输入卡片高度不变，所以这里用和输入框一样的最小高度
                            .height(24.76.dp)
                            .pointerInteropFilter { ev ->
                                // 官方上滑取消是跟着手指实时变红的，这里用原始 MotionEvent 拿绝对坐标，
                                // 不走 Compose 手势（awaitFirstDown/awaitPointerEvent 在某些父容器下收不到 MOVE）
                                val cancelPx = voiceCancelPx
                                when (ev.actionMasked) {
                                    MotionEvent.ACTION_DOWN -> {
                                        voiceDownY[0] = ev.rawY
                                        voiceArmed[0] = false
                                        runCatching { onVoiceStart() }
                                        onVoiceCancelArm(false)
                                    }
                                    MotionEvent.ACTION_MOVE -> {
                                        val now = (voiceDownY[0] - ev.rawY) > cancelPx
                                        if (now != voiceArmed[0]) {
                                            voiceArmed[0] = now
                                            onVoiceCancelArm(now)
                                        }
                                    }
                                    MotionEvent.ACTION_UP, MotionEvent.ACTION_CANCEL -> {
                                        if (voiceArmed[0]) onVoiceCancel() else onVoiceStop()
                                        voiceArmed[0] = false
                                    }
                                }
                                true
                            },
                        contentAlignment = Alignment.Center,
                    ) {
                        Text(
                            text = if (voiceListening) "松开 结束" else "按住 说话",
                            fontSize = 16.75.sp,
                            color = Color(0xFF2A2C33),
                        )
                    }
                }
                // 官方：只有语音态才看得见这条 1dp 浅灰线；
                // 但布局上一直占位（透明），否则切模式时卡片会一高一矮。
                Box(
                    Modifier
                        .fillMaxWidth()
                        .padding(top = 6.dp, bottom = 2.dp)
                        .height(1.dp)
                        .background(if (voiceMode || voiceHolding) Color(0xFFF0F0F0) else Color.Transparent),
                )
                Row(
                    Modifier
                        .fillMaxWidth()
                        .height(47.62.dp)
                        .padding(top = 0.dp),
                    verticalAlignment = Alignment.CenterVertically,
                ) {
                    Chip(R.drawable.ic_think_outline_16, "深度思考", thinking, onToggleThinking, 114.29.dp, lottieRes = R.raw.think, lottieOnRes = R.raw.think_on)
                    Chip(R.drawable.ic_search_web, "智能搜索", search, onToggleSearch, 95.24.dp, lottieRes = R.raw.globe, lottieOnRes = R.raw.globe_on)
                    Spacer(Modifier.weight(1f))
                    // 上下文用量圈：放在「+」左边 8dp，与「+」图标在 30.10dp 高度里居中对齐，
                    // 自带 clickable（点开气泡），完全不影响「+」原来的点击区域。
                    ContextUsageRing(
                        used = contextUsed,
                        limit = contextLimit,
                        modifier = Modifier.size(30.10.dp),
                    )
                    Spacer(Modifier.width(8.dp))
                    Box(
                        Modifier
                            .offset(x = 1.90.dp)
                            .width(41.90.dp)
                            .height(30.10.dp)
                            .clip(RoundedCornerShape(10.dp))
                            .clickable(onClick = onAddAttachment),
                        contentAlignment = Alignment.CenterEnd,
                    ) {
                        // 官方实测：空输入=裸加号(墨迹23.24@315.43)，有文字=带圈加号(墨迹23.24@318.10)，附件面板开=叉
                        Icon(
                            // 官方：加号恒为带圈 ⊕（ic_add_outline_26），面板打开时变 ✕
                            painter = painterResource(
                                if (attachOpen) R.drawable.ic_add_close_circle_26 else R.drawable.ic_add_outline_26
                            ),
                            contentDescription = if (attachOpen) "关闭" else "上传文件",
                            tint = ds.bodyText,
                            modifier = Modifier.size(24.60.dp),
                        )
                    }
                    Box(
                        Modifier
                            .offset(x = 1.90.dp)
                            .width(59.05.dp)
                            .height(30.10.dp)
                            .clickable { if (sending) onStop() else if (value.isNotBlank() || attachments.isNotEmpty()) onSend() else Unit },
                        contentAlignment = Alignment.Center,
                    ) {
                        val showSend = sending || value.isNotBlank() || attachments.isNotEmpty()
                        if (showSend) {
                            // 官方实测：发送/停止圆 28.57dp，箭头 12.19dp，方块 10.67dp
                            Box(
                                Modifier
                                    .size(28.57.dp)
                                    .clip(CircleShape)
                                    .background(DsBlue)
                                    .clickable { if (sending) onStop() else onSend() },
                                contentAlignment = Alignment.Center,
                            ) {
                                Icon(
                                    painter = painterResource(if (sending) R.drawable.ic_stop_fill_20 else R.drawable.ic_send_fill_20),
                                    contentDescription = if (sending) "停止" else "发送",
                                    tint = Color.White,
                                    modifier = Modifier.size(if (sending) 13.14.dp else 15.00.dp),
                                )
                            }
                        } else {
                            // 官方：这个按钮短按切「按住说话」，长按直接录音（不用先切模式）。
                            // 之前只有 clickable，长按没反应。
                            val scope = androidx.compose.runtime.rememberCoroutineScope()
                            var pressJob by androidx.compose.runtime.remember { androidx.compose.runtime.mutableStateOf<kotlinx.coroutines.Job?>(null) }
                            var longPressing by androidx.compose.runtime.remember { androidx.compose.runtime.mutableStateOf(false) }
                            val cancelPx = with(androidx.compose.ui.platform.LocalDensity.current) { 60.dp.toPx() }
                            val downY = androidx.compose.runtime.remember { floatArrayOf(0f) }
                            Box(
                                Modifier
                                    .size(24.76.dp)
                                    .pointerInteropFilter { ev ->
                                        when (ev.action) {
                                            android.view.MotionEvent.ACTION_DOWN -> {
                                                downY[0] = ev.rawY
                                                pressJob = scope.launch {
                                                    kotlinx.coroutines.delay(260)
                                                    longPressing = true
                                                    runCatching { onVoiceStart() }
                                                    onVoiceCancelArm(false)
                                                }
                                                true
                                            }
                                            android.view.MotionEvent.ACTION_MOVE -> {
                                                if (longPressing) {
                                                    val up = downY[0] - ev.rawY
                                                    onVoiceCancelArm(up > cancelPx)
                                                }
                                                longPressing
                                            }
                                            android.view.MotionEvent.ACTION_UP, android.view.MotionEvent.ACTION_CANCEL -> {
                                                pressJob?.cancel()
                                                if (longPressing) {
                                                    longPressing = false
                                                    val up = downY[0] - ev.rawY
                                                    if (up > cancelPx || ev.action == android.view.MotionEvent.ACTION_CANCEL) onVoiceCancel() else onVoiceStop()
                                                } else {
                                                    onToggleVoice()
                                                }
                                                true
                                            }
                                            else -> false
                                        }
                                    },
                                contentAlignment = Alignment.Center,
                            ) {
                                Icon(
                                    painter = painterResource(
                                        if (voiceMode) R.drawable.ic_keyboard_outline_26 else R.drawable.ic_voice_outline_26
                                    ),
                                    contentDescription = if (voiceMode) "切换至键盘" else "按住说话",
                                    tint = ds.bodyText,
                                    modifier = Modifier.size(24.76.dp),
                                )
                            }
                        }
                    }
                }
            }
        }
        if (showFooter) {
            Box(
                Modifier
                    .fillMaxWidth()
                    .padding(top = 4.95.dp)
                    .height(11.43.dp),
                contentAlignment = Alignment.Center,
            ) {
                Text(
                    text = "回答由 AI 生成，仅供参考",
                    modifier = Modifier.fillMaxWidth(),
                    fontSize = 11.sp,
                    lineHeight = 11.sp,
                    textAlign = TextAlign.Center,
                    color = ds.footer,
                )
            }
        }
    }
}

/**
 * 官方附件菜单：输入卡下方的三块方形按钮（拍照 / 相册 / 文件）。
 * 每块 119.6×80dp，间距 7.62dp，左右 19.05dp，圆角 12.95dp，底色 #F5F5F5。
 */
@Composable
fun AttachmentTileRow(
    onCamera: () -> Unit,
    onGallery: () -> Unit,
    onFile: () -> Unit,
) {
    val ds = LocalDsColors.current
    Row(
        Modifier
            .fillMaxWidth()
            .padding(start = 19.05.dp, end = 19.05.dp, top = 20.21.dp),
        horizontalArrangement = Arrangement.spacedBy(7.62.dp),
    ) {
        AttachTile(R.drawable.ic_camera_outline_20, "拍照", Modifier.weight(1f), onCamera)
        AttachTile(R.drawable.ic_photo_outline_20, "相册", Modifier.weight(1f), onGallery)
        AttachTile(R.drawable.ic_paperclip_outline_20, "文件", Modifier.weight(1f), onFile)
    }
}

@Composable
private fun AttachTile(icon: Int, label: String, modifier: Modifier, onClick: () -> Unit) {
    val ds = LocalDsColors.current
    Column(
        modifier
            .height(80.dp)
            .clip(RoundedCornerShape(12.95.dp))
            .background(ds.tileBg)
            .clickable(onClick = onClick),
        verticalArrangement = Arrangement.Center,
        horizontalAlignment = Alignment.CenterHorizontally,
    ) {
        Icon(
            painter = painterResource(icon),
            contentDescription = label,
            tint = ds.bodyText,
            modifier = Modifier.size(24.dp),
        )
        Spacer(Modifier.height(6.dp))
        Text(text = label, fontSize = 14.sp, color = ds.bodyText)
    }
}

// =====================================================================================
//  上下文用量圈（类似 Codex / DSH 的细环）
// =====================================================================================

/**
 * 22dp 细环：先画整圈底色 #E8EAED（stroke 2.5dp），再按进度从 -90° 顺时针画前景弧。
 * 前景色随用量变化：正常 #4C8DF6，> 0.9 #FF9F0A，> 0.98 #FF5757。
 * 点一下圆圈弹出小气泡（点外面消失），圆圈本身 clickable，不影响「+」的点击。
 */
@Composable
private fun ContextUsageRing(
    used: Int,
    limit: Int,
    modifier: Modifier = Modifier,
) {
    val progress = if (limit <= 0) 0f else (used.toFloat() / limit.toFloat()).coerceIn(0f, 1f)
    val fg = when {
        progress > 0.98f -> Color(0xFFFF5757)
        progress > 0.90f -> Color(0xFFFF9F0A)
        else -> Color(0xFF4C8DF6)
    }
    var open by remember { mutableStateOf(false) }
    // 气泡定位：环高 22dp + 8dp 间距，气泡贴在圆环正上方
    val bubbleLift = with(LocalDensity.current) { 34.dp.roundToPx() }

    Box(modifier, contentAlignment = Alignment.Center) {
        Box(
            Modifier
                .size(22.dp)
                .clip(CircleShape)
                .clickable { open = !open },
            contentAlignment = Alignment.Center,
        ) {
            Canvas(Modifier.fillMaxSize()) {
                val sw = 2.5.dp.toPx()
                val inset = sw / 2f
                val arcSize = Size(size.width - sw, size.height - sw)
                val topLeft = Offset(inset, inset)
                // 整圈底色
                drawArc(
                    color = Color(0xFFE8EAED),
                    startAngle = 0f,
                    sweepAngle = 360f,
                    useCenter = false,
                    topLeft = topLeft,
                    size = arcSize,
                    style = Stroke(width = sw),
                )
                if (progress > 0f) {
                    if (progress >= 1f) {
                        // 满环不再用圆头，避免首尾叠出一个凸起
                        drawArc(
                            color = fg,
                            startAngle = 0f,
                            sweepAngle = 360f,
                            useCenter = false,
                            topLeft = topLeft,
                            size = arcSize,
                            style = Stroke(width = sw),
                        )
                    } else {
                        drawArc(
                            color = fg,
                            startAngle = -90f,
                            sweepAngle = 360f * progress,
                            useCenter = false,
                            topLeft = topLeft,
                            size = arcSize,
                            style = Stroke(width = sw, cap = StrokeCap.Round),
                        )
                    }
                }
            }
        }
        if (open) {
            Popup(
                alignment = Alignment.BottomEnd,
                offset = IntOffset(0, -bubbleLift),
                onDismissRequest = { open = false },
                properties = PopupProperties(
                    focusable = true,
                    dismissOnBackPress = true,
                    dismissOnClickOutside = true,
                ),
            ) {
                ContextUsageBubble(used = used, limit = limit)
            }
        }
    }
}

/** 圆环点开的小气泡：「已用 12.3k / 128k」「剩余 115.7k」 */
@Composable
private fun ContextUsageBubble(used: Int, limit: Int) {
    val ds = LocalDsColors.current
    val remaining = (limit - used).coerceAtLeast(0)
    Column(
        Modifier
            .clip(RoundedCornerShape(10.dp))
            .background(ds.cardBg)
            .border(1.dp, ds.chipBorder, RoundedCornerShape(10.dp))
            .padding(horizontal = 12.dp, vertical = 8.dp),
    ) {
        Text(
            text = "已用 ${formatTokenCount(used)} / ${formatTokenCount(limit)}",
            fontSize = 13.sp,
            color = ds.rowText,
            maxLines = 1,
        )
        Spacer(Modifier.height(3.dp))
        Text(
            text = "剩余 ${formatTokenCount(remaining)}",
            fontSize = 12.sp,
            color = ds.secondary,
            maxLines = 1,
        )
    }
}

/** token 数字格式化：>= 1000 用 k，保留 1 位小数（128.0k 显示成 128k） */
private fun formatTokenCount(n: Int): String {
    if (n < 1000) return n.toString()
    var s = String.format(java.util.Locale.US, "%.1f", n / 1000.0)
    if (s.endsWith(".0")) s = s.dropLast(2)
    return s + "k"
}

/** 卡片内的语音波形：55 条竖条，颜色随时间在蓝色之间流动（官方 animatedWaveformColor） */
@Composable
private fun VoiceWaveInCard(level: Float, bands: FloatArray, canceling: Boolean) {
    val tr = androidx.compose.animation.core.rememberInfiniteTransition(label = "waveColor")
    val t by tr.animateFloat(
        initialValue = 0f,
        targetValue = 1f,
        animationSpec = androidx.compose.animation.core.infiniteRepeatable(
            animation = androidx.compose.animation.core.tween(1600, easing = androidx.compose.animation.core.LinearEasing),
        ),
        label = "waveT",
    )
    val c1 = Color(0xFF4C8DF6)
    val c2 = Color(0xFF9DBBFA)
    val mix = (0.5f + 0.5f * kotlin.math.sin(t * 2f * Math.PI.toFloat()).toFloat())
    val barColor = if (canceling) Color(0xFFFF5757)
    else androidx.compose.ui.graphics.lerp(c1, c2, (mix * 0.6f).coerceIn(0f, 1f))
    val n = 55
    Row(
        Modifier
            .fillMaxWidth()
            .padding(horizontal = DsMetric.CARD_PAD_H.dp)
            .height(24.76.dp),
        horizontalArrangement = Arrangement.spacedBy(1.6.dp),
        verticalAlignment = Alignment.CenterVertically,
    ) {
        for (i in 0 until n) {
            // 中间高两边低的包络 + 实际幅度
            val d = kotlin.math.abs(i - (n - 1) / 2f) / ((n - 1) / 2f)
            val env = 0.35f + 0.65f * (1f - d * d)
            val lv = bands.getOrElse(i) { level }.coerceIn(0f, 1f)
            val hh = (3f + 21f * lv) * env
            Box(
                Modifier
                    .weight(1f)
                    .height(hh.dp)
                    .clip(RoundedCornerShape(1.dp))
                    .background(barColor),
            )
        }
    }
}
