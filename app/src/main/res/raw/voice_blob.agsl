// AGSL port of the official DeepSeek app shader.
// Source: assets/shaders/fluid_blob.agsl (RuntimeShader tier, API 33+)
//         mirrored by assets/shaders/fluid_blob.frag (OpenGL tier).
// Math is kept byte-for-bit identical to the official source; only the
// non-ASCII comments were dropped so the AGSL compiler accepts the file.
//
// Uniforms and who sets them in the official app:
//   time, resolution, pixelRatio, offset  -> FluidBlobShader.set(...)
//   scale, rotation, colorCount, grain, proportion, softness, shape,
//   shapeScale, distortion, swirl, swirlIterations -> FluidBlobConfig.pattern
//   color1/2/3 -> FluidColorPalette base / flow / highlight

uniform float4 color1;
uniform float4 color2;
uniform float4 color3;
uniform float2 resolution;
uniform float2 offset;
uniform float time;
uniform float pixelRatio;
uniform float scale;
uniform float rotation;
uniform float colorCount;
uniform float grain;
uniform float proportion;
uniform float softness;
uniform float shape;
uniform float shapeScale;
uniform float distortion;
uniform float swirl;
uniform float swirlIterations;

const float PT_TWO_PI = 6.28318530718;
const float PT_PI = 3.14159265359;

// GLSL mat2 is column major, matching the two column vectors of float2x2.
float2 pt_rotate(float2 uv, float th) {
    return float2x2(cos(th), sin(th), -sin(th), cos(th)) * uv;
}

// Permute integer lattice coordinates modulo 256. Splitting x into base-16
// digits evaluates (2*x*x + x) mod 256 with integer intermediates <= 897,
// representable even in mediump. Power-of-two moduli/divisors are exact.
// Avoid sin-based hashes: tiny corner-evaluation differences get amplified by
// their large multiplier and fract(), breaking continuity between noise cells.
float pt_permute(float x) {
    x = mod(x, 256.0);
    float lo = mod(x, 16.0);
    float hi = floor(x / 16.0);
    return mod((2.0 * lo + 1.0) * lo + 16.0 * hi
        + 64.0 * mod(lo * hi, 4.0), 256.0);
}

float pt_random(float2 st) {
    float2 p = mod(floor(st), 256.0);
    // Fixed seeds decorrelate the small coordinate range of the voice preview.
    return pt_permute(pt_permute(p.x + 37.0) + p.y + 97.0) / 256.0;
}

float pt_noise(float2 st) {
    float2 i = floor(st);
    float2 f = fract(st);
    float a = pt_random(i);
    float b = pt_random(i + float2(1.0, 0.0));
    float c = pt_random(i + float2(0.0, 1.0));
    float d = pt_random(i + float2(1.0, 1.0));
    float2 u = f * f * (3.0 - 2.0 * f);
    float x1 = mix(a, b, u.x);
    float x2 = mix(c, d, u.x);
    return mix(x1, x2, u.y);
}

float3 pt_blendMulti(float mixer, float soft) {
    float e = 0.35 * (1.0 - soft);
    float3 col = color1.rgb;
    if (colorCount > 1.5) {
        float r1 = smoothstep(e, 0.7 - e, mixer);
        col = mix(col, color2.rgb, r1);
    }
    if (colorCount > 2.5) {
        float r2 = smoothstep(0.3 + e, 1.0 - e, mixer);
        col = mix(col, color3.rgb, r2);
    }
    return col;
}

half4 main(float2 fragCoord) {
    float2 uv = fragCoord / resolution;
    // AGSL origin is top-left; flip back to the GLSL bottom-left origin.
    uv.y = 1.0 - uv.y;

    float t = 0.5 * time;

    float noise_scale = 0.0005 + 0.006 * scale;

    uv -= 0.5;
    uv *= (noise_scale * resolution);
    uv = pt_rotate(uv, rotation * 0.5 * PT_PI);
    uv /= pixelRatio;
    uv += 0.5;
    uv += offset;

    float n1 = pt_noise(uv + t);
    float n2 = pt_noise(uv * 2.0 - t);
    float angle = n1 * PT_TWO_PI;
    uv += (4.0 * distortion * n2) * float2(cos(angle), sin(angle));

    // AGSL requires a constant loop bound: fixed 10 iterations plus break.
    // clamp(swirl) is hoisted out of the loop; when swirl == 0 the whole loop
    // is skipped safely.
    float sw = clamp(swirl, 0.0, 2.0);
    if (sw > 0.0) {
        float iterations = ceil(clamp(swirlIterations, 1.0, 10.0));
        for (int i = 1; i <= 10; i++) {
            float fi = float(i);
            if (fi > iterations) { break; }
            float k = sw / fi;
            uv.x += k * cos(t + fi * 1.5 * uv.y);
            uv.y += k * cos(t + fi * uv.x);
        }
    }

    float prop = clamp(proportion, 0.0, 1.0);
    float propD = prop - 0.5;
    // pow(x, 0.5) == sqrt(x); sqrt is cheaper and numerically more stable.
    float propBias = 0.48 * sign(propD) * sqrt(abs(propD));
    float shapeVal = 0.0;
    float mixer = 0.0;
    if (shape < 0.5) {
        float2 checks_shape_uv = uv * (0.5 + 3.5 * shapeScale);
        shapeVal = 0.5 + 0.5 * sin(checks_shape_uv.x) * cos(checks_shape_uv.y);
        mixer = shapeVal + propBias;
    } else if (shape < 1.5) {
        float2 stripes_shape_uv = uv * (0.25 + 3.0 * shapeScale);
        float f = fract(stripes_shape_uv.y);
        shapeVal = smoothstep(0.0, 0.55, f) * smoothstep(1.0, 0.45, f);
        mixer = shapeVal + propBias;
    } else {
        float sh = 1.0 - uv.y;
        sh -= 0.5;
        sh /= (noise_scale * resolution.y);
        sh += 0.5;
        float shape_scaling = 0.2 * (1.0 - shapeScale);
        shapeVal = smoothstep(
            0.45 - shape_scaling, 0.55 + shape_scaling, sh + 0.3 * propD);
        mixer = shapeVal;
    }

    float3 col = pt_blendMulti(mixer, clamp(softness, 0.0, 1.0));

    if (grain > 0.0) {
        float g = pt_random(fragCoord + float2(time * 100.0));
        col += (g - 0.5) * grain;
    }

    return half4(half3(clamp(col, 0.0, 1.0)), 1.0);
}
